[Unit]
Description=MeshBridge Discord-MeshCore Bridge
After=network.target

[Service]
Type=simple
User=REPLACE_ME
WorkingDirectory=/opt/MeshBridge
ExecStart=/opt/MeshBridge/.venv/bin/python /opt/MeshBridge/main.py --config /opt/MeshBridge/config.hjson --log-level INFO
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
