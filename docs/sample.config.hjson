{
  # ============================================================================
  # Discord settings
  # ============================================================================
  discord_token: "PUT_DISCORD_BOT_TOKEN_HERE"
  discord_application_id: 1490809692601979003
  discord_guild_id: 1490808954438025218

  # Optional private room for Mesh DMs if you do not want direct Discord DMs.
  mesh_dm_channel_id: 1490809019370049810

  # Optional direct Discord DM target user.
  # This should be YOUR DISCORD USER ID, not the bot application ID.
  mesh_dm_user_id: 100713322097156096

  # Fixed avatar used by Mesh -> Discord webhook posts.
  meshcore_avatar_url: "https://raw.githubusercontent.com/meshcore-dev/MeshCore/main/images/icon.png"

  # ============================================================================
  # MeshCore connection settings
  # ============================================================================
  serial_port: "/dev/ttyACM0"
  baud_rate: 115200

  # ============================================================================
  # Logging
  # ============================================================================
  #
  # log_mode options:
  # - DEBUG
  # - TRAFFICONLY
  # - RFONLY
  # - QUIET
  #
  debug: true
  log_level: "DEBUG"
  log_mode: "TRAFFICONLY"
  log_file: "meshbridge.log"

  # ============================================================================
  # Runtime / cache
  # ============================================================================
  max_message_history: 100
  max_unhandled_events: 100
  neighbor_cache_file: "neighbors.json"
  neighbor_cache_limit: 5

  # ============================================================================
  # Rate limiting
  # ============================================================================
  rate_limit_window_seconds: 15
  rate_limit_max_messages: 6

  # ============================================================================
  # Mesh chunking
  # ============================================================================
  mesh_chunk_size: 120
  mesh_chunk_delay_seconds: 2.5

  # ============================================================================
  # Webhook / reconnect
  # ============================================================================
  webhook_timeout_seconds: 10
  reconnect_initial_delay_seconds: 2
  reconnect_max_delay_seconds: 30

  # ============================================================================
  # Auto-probe
  # ============================================================================
  #
  # If enabled, the bridge will send path discovery when it hears a new advert,
  # subject to the per-node cooldown below.
  #
  auto_probe_on_advert: true
  auto_probe_min_interval_seconds: 300

  # ============================================================================
  # Routes
  # ============================================================================
  routes: [
    {
      name: "PUBLIC"
      mesh_channel: 0
      discord_channel_id: 1490838749524005005
      webhook_url: "https://discord.com/api/webhooks/PUT_ROUTE_0_WEBHOOK_HERE"
    }
    {
      name: "Volusia Bridge"
      mesh_channel: 1
      discord_channel_id: 1490809019370049810
      webhook_url: "https://discord.com/api/webhooks/PUT_ROUTE_1_WEBHOOK_HERE"
    }
    {
      name: "WX4CB"
      mesh_channel: 2
      discord_channel_id: 1490842865339732100
      webhook_url: "https://discord.com/api/webhooks/PUT_ROUTE_2_WEBHOOK_HERE"
    }
  ]
}
