{
  # ============================================================================
  # Discord settings
  # ============================================================================
  discord_token: "PUT_DISCORD_BOT_TOKEN_HERE"
  discord_application_id: 123456789012345678
  discord_guild_id: 123456789012345678

  # Optional private room for Mesh direct messages if you do not want user DMs.
  mesh_dm_channel_id: null

  # Optional direct Discord DM target user.
  # If both are set, mesh_dm_user_id takes priority over mesh_dm_channel_id.
  mesh_dm_user_id: null

  # Fixed avatar used by Mesh -> Discord webhook posts.
  meshcore_avatar_url: "https://raw.githubusercontent.com/meshcore-dev/MeshCore/main/images/icon.png"

  # ============================================================================
  # MeshCore connection settings
  # ============================================================================
  # Use "serial" for a local serial companion or "tcp" for a pymc TCP endpoint.
  mesh_connection_type: "serial"

  # Serial settings, used when mesh_connection_type is "serial".
  # Prefer a stable udev symlink under /dev/serial/by-id/ when available.
  # serial_port: "/dev/ttyACM0"
  serial_port: "/dev/serial/by-id/usb-Espressif_Systems_heltec_wifi_lora_32_v4__16_MB_FLASH__2_MB_PSRAM__90706984D248-if00"
  baud_rate: 115200

  # TCP settings, used when mesh_connection_type is "tcp".
  tcp_host: "127.0.0.1"
  tcp_port: 5000

  # After switching companions or transports, run /channels once and verify
  # that your route mesh_channel indices still match the connected node's live
  # channel order.

  # ============================================================================
  # Logging
  # ============================================================================
  # log_level is the normal Python severity threshold.
  debug: false
  log_level: "INFO"

  # log_modes selects MeshBridge logging categories.
  # Use a list or a comma-separated string.
  log_modes: [
    "SYSTEM"
    "TRAFFICONLY"
  ]
  log_file: "meshbridge.log"

  # ============================================================================
  # Runtime / cache
  # ============================================================================
  max_message_history: 100
  max_unhandled_events: 100
  neighbor_cache_file: "neighbors.json"
  neighbor_cache_limit: 5

  # ============================================================================
  # Flood / rate limiting
  # ============================================================================
  rate_limit_window_seconds: 10
  rate_limit_max_messages: 5

  # ============================================================================
  # Mesh chunking
  # ============================================================================
  mesh_chunk_size: 180
  mesh_chunk_delay_seconds: 0.5

  # ============================================================================
  # Webhook / reconnect behavior
  # ============================================================================
  webhook_timeout_seconds: 10
  reconnect_initial_delay_seconds: 2
  reconnect_max_delay_seconds: 30

  # ============================================================================
  # Auto-probe behavior
  # ============================================================================
  auto_probe_on_advert: true
  auto_probe_min_interval_seconds: 300

  # ============================================================================
  # Auto-advert behavior
  # ============================================================================
  # 0 disables scheduled adverts. Positive values send one advert every N hours.
  auto_advert_interval_hours: 0

  # Use true only if you intentionally want scheduled flood adverts.
  auto_advert_flood: false

  # ============================================================================
  # Routes
  # ============================================================================
  routes: [
    {
      name: "public"
      mesh_channel: 0
      discord_channel_id: 123456789012345678
      webhook_url: "https://discord.com/api/webhooks/PUT_ROUTE_WEBHOOK_HERE"
    }
  ]
}
