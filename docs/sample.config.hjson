{
  # ============================================================================
  # Discord settings
  # ============================================================================
  discord_token: "PUT_DISCORD_BOT_TOKEN_HERE"
  discord_application_id: "APPLICATION ID"
  discord_guild_id: GUILD ID 

  # Optional private room for Mesh DMs if you do not want direct Discord DMs.
  mesh_dm_channel_id: xxxxxxxxxxxxxxxxxxx

  # Optional direct Discord DM target user.
  # This must be YOUR DISCORD USER ID, not the bot application ID.
  mesh_dm_user_id: DISCORD USER ID

  # Fixed avatar used by Mesh -> Discord webhook posts.
  meshcore_avatar_url: "https://raw.githubusercontent.com/meshcore-dev/MeshCore/main/images/icon.png"

  # ============================================================================
  # MeshCore connection settings
  # ============================================================================
  serial_port: "/dev/ttyACM0"
  baud_rate: 115200

  # ============================================================================
  # Logging
  # ============================================================================
  #
  # log_level controls the normal Python severity threshold.
  #
  # Allowed values:
  # - DEBUG
  # - INFO
  # - WARNING
  # - ERROR
  # - CRITICAL
  #
  debug: true
  log_level: "DEBUG"

  #
  # log_modes controls which MeshBridge logging categories are enabled.
  #
  # Allowed values:
  # - DEBUG
  # - SYSTEM
  # - TRAFFICONLY
  # - RFONLY
  # - QUIET
  #
  # You can enable multiple categories at once.
  #
  # Example: traffic + RF together
  #
  log_modes: [
    "TRAFFICONLY"
    "RFONLY"
  ]

  #
  # You can also use a comma-separated string if you prefer:
  #
  # log_modes: "TRAFFICONLY,RFONLY"
  #
  log_file: "meshbridge.log"

  # ============================================================================
  # Runtime / cache
  # ============================================================================
  max_message_history: 100
  max_unhandled_events: 100
  neighbor_cache_file: "neighbors.json"
  neighbor_cache_limit: 5

  # ============================================================================
  # Rate limiting
  # ============================================================================
  rate_limit_window_seconds: 15
  rate_limit_max_messages: 6

  # ============================================================================
  # Mesh chunking
  # ============================================================================
  mesh_chunk_size: 120
  mesh_chunk_delay_seconds: 2.5

  # ============================================================================
  # Webhook / reconnect
  # ============================================================================
  webhook_timeout_seconds: 10
  reconnect_initial_delay_seconds: 2
  reconnect_max_delay_seconds: 30

  # ============================================================================
  # Auto-probe
  # ============================================================================
  #
  # If enabled, the bridge may send path discovery when it hears a new advert,
  # subject to the per-node cooldown below.
  #
  auto_probe_on_advert: true
  auto_probe_min_interval_seconds: 300

  # ============================================================================
  # Routes
  # ============================================================================
  routes: [
    {
      name: "PUBLIC"
      mesh_channel: 0
      discord_channel_id: CHANNEL ID
      webhook_url: "https://discord.com/api/webhooks/PUT_ROUTE_0_WEBHOOK_HERE"
    }
  ]
}
